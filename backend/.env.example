# Runtime profile: development, test, or production.
MES_ENV=development

# Comma-separated browser origins and HTTP Host values allowed by the API.
MES_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MES_ALLOWED_HOSTS=127.0.0.1,localhost

# Lightweight protection for this local/internal demo API.
MES_WRITE_RATE_LIMIT=60
MES_MAX_REQUEST_BYTES=65536
